{
  "name": "@retainer/extension",
  "version": "0.1.0",
  "description": "Build-time contracts for reviewed Retainer extensions",
  "license": "MIT",
  "homepage": "https://github.com/Tamloot-cc/Retainer/tree/main/packages/extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tamloot-cc/Retainer.git",
    "directory": "packages/extension"
  },
  "bugs": "https://github.com/Tamloot-cc/Retainer/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@retainer/shared": "workspace:*",
    "zod": "^4.6.7"
  }
}
