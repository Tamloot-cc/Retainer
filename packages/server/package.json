{
  "name": "@retainer/server",
  "version": "0.1.0",
  "private": true,
  "description": "Retainer server: REST API, MCP endpoint, workers and schema engine.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:viewer": "tsx --env-file-if-exists=../../.env src/db/viewer.ts",
    "db:studio": "drizzle-kit studio",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1166.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@better-auth/cimd": "1.7.18",
    "@better-auth/mcp": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/server": "^2.4.0",
    "@retainer/extension": "workspace:*",
    "@retainer/shared": "workspace:*",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "6.2.15",
    "libphonenumber-js": "^1.13.15",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.0",
    "@retainer/runner": "workspace:*",
    "@retainer/sdk": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "bin": {
    "retainer": "./dist/cli.js"
  }
}
